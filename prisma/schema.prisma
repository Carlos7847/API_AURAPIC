// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  USER
  ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  PENDING // Email no verificado
  SUSPENDED // Baneado temporalmente
  DELETED // Soft delete
}

enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
  APPLE
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  fullName String?

  // Control de Acceso y Estado
  role   UserRole   @default(USER)
  status UserStatus @default(PENDING)

  // Verificación y Seguridad
  emailVerifiedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft Delete

  // Relaciones
  credentials AuthCredential[]
  sessions    Session[]
  imageAssets ImageAsset[]
  jobs        Job[]

  auditLogs    AuditLog[]
  subscription Subscription?
  payments     Payment[]

  @@index([email])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String    @default("FREE")
  status               String    @default("ACTIVE") // ACTIVE, CANCELLED, PAST_DUE
  creditsRemaining     Int       @default(10) // Free tier starts with 10 credits
  currentPeriodStart   DateTime  @default(now())
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model PromptTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  template  String // "A professional e-commerce shot of {{product}} with {{lighting}} lighting..."
  category  String? // "E-commerce", "Portrait"
  variables Json? // ["product", "lighting"]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Memory {
  id        String                      @id @default(cuid())
  ownerType String // "USER", "JOB", "GLOBAL"
  ownerId   String? // userId or jobId
  content   String // The text content
  embedding Unsupported("vector(768)")? //  Gemini (default) Embedding dimensions
  metadata  Json?
  createdAt DateTime                    @default(now())

  @@index([ownerType, ownerId])
}

// Payment providers available (MercadoPago, Culqi, Crypto, etc.)
model PaymentProvider {
  id       String  @id @default(cuid())
  code     String  @unique // "mercadopago", "culqi", "crypto"
  name     String // "Mercado Pago", "Culqi", "Criptomonedas"
  isActive Boolean @default(true)

  // UI/UX metadata (NOT credentials - those go in .env)
  displayConfig Json? @db.JsonB // Logo, description, fees, supported currencies, etc.

  // Circuit Breaker state
  healthStatus    String    @default("HEALTHY") // HEALTHY, DEGRADED, DOWN
  lastHealthCheck DateTime?
  failureCount    Int       @default(0)
  lastFailureAt   DateTime?

  // Relations
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([healthStatus])
  @@index([displayConfig], type: Gin)
}

model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Payment Provider relation
  providerId String
  provider   PaymentProvider @relation(fields: [providerId], references: [id])

  // Payment Provider specific
  preferenceId        String  @unique // Provider Preference/Session ID
  providerPaymentId   String? @unique // Provider Payment ID (once paid)
  providerCollectorId String? // Payment provider collector (seller) ID

  // Payment details
  amount       Float
  currency     String  @default("PEN") // Peruvian Sol
  status       String  @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED, REFUNDED
  statusDetail String? // Additional status info from provider

  // Credits
  creditsAmount Int // How many credits this purchase grants
  packageId     String?
  package       CreditPackage? @relation(fields: [packageId], references: [id])

  // Metadata
  description       String?
  externalReference String? // Custom reference
  paymentMethodId   String? // visa, mastercard, pago_efectivo, etc.
  paymentTypeId     String? // credit_card, debit_card, ticket, etc.
  idempotencyKey    String? @unique // For duplicate prevention
  metadata          Json? // Additional provider metadata

  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([providerId])
  @@index([providerPaymentId])
  @@index([status])
  @@index([createdAt])
}

model CreditPackage {
  id          String  @id @default(cuid())
  name        String  @unique // "Starter", "Pro", "Business"
  credits     Int
  price       Float
  currency    String  @default("PEN")
  active      Boolean @default(true)
  description String?
  metadata    Json?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model WebhookEvent {
  id String @id @default(cuid())

  // Webhook identification
  providerEventId String? @unique // Payment provider event ID
  action          String // payment.created, payment.updated
  type            String? // payment, subscription, etc.

  // Processing
  processed   Boolean   @default(false)
  processedAt DateTime?
  attempts    Int       @default(0)

  // Data
  payload   Json // Raw webhook payload
  paymentId String? // Linked payment ID if applicable

  // Error tracking
  error String?

  createdAt DateTime @default(now())

  @@index([processed])
  @@index([providerEventId])
  @@index([createdAt])
}

model AuthCredential {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider       AuthProvider
  providerUserId String
  // Para EMAIL, providerUserId = email. Para Google, providerUserId = google_id.

  passwordHash String? // Solo para provider = EMAIL

  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?

  emailVerificationTokenHash String?   @unique
  emailVerificationExpiresAt DateTime?

  // MFA / 2FA 
  tfaEnabled       Boolean  @default(false)
  tfaSecret        String? // ENCRIPTADO AES-256
  tfaRecoveryCodes String[] // ENCRIPTADO

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // un usuario no puede tener dos credenciales del mismo proveedor
  @@unique([provider, providerUserId])
  // Un usuario solo debe tener una credencial de cada tipo (ej: solo un google, solo una password)
  @@unique([userId, provider])
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique // Hash SHA256

  // para detectar anomalías
  deviceInfo String? // "Chrome on MacOS"
  ipAddress  String?
  userAgent  String?
  location   String? // GeoIP

  // Rotation & Expiry
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())

  // Revocación y Rotación
  revokedAt    DateTime?
  replacedById String? // Family Tree para detección de robo

  @@index([userId])
  @@index([expiresAt]) // para limpiar con CRON
}

// Auditoría de Seguridad
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // LOGIN, LOGIN_FAILED, PASSWORD_CHANGE, 2FA_ENABLE
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model ImageAsset {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey String   @unique // Clave completa en Storage (S3, GCS, etc)
  url        String
  kind       String   @default("input") // input | output | thumbnail
  width      Int?
  height     Int?
  sizeBytes  Int?
  createdAt  DateTime @default(now())

  // Relación inversa: si es output, se vincula a JobResult
  jobResult JobResult?

  @@index([userId])
  @@index([kind])
}

model Job {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageId    String? // Referencia a ImageAsset de entrada
  mode       String // e-commerce-pro, portrait, etc
  status     String     @default("queued") // queued, processing, completed, failed
  prompt     String?
  promptVars Json?
  meta       Json? // adicional
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  result     JobResult?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model JobResult {
  id        String      @id @default(cuid())
  jobId     String      @unique
  job       Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  imageId   String?     @unique
  image     ImageAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  url       String // URL del resultado en el Storage (S3)
  width     Int?
  height    Int?
  sizeBytes Int?
  metadata  Json? // Datos del proceso (modelo usado, tiempo, etc)
  createdAt DateTime    @default(now())

  @@index([jobId])
  @@index([imageId])
}

// ============================================
// OUTBOX PATTERN (Event Consistency)
// ============================================

/// Transactional Outbox for guaranteed event delivery
/// Ensures events are persisted atomically with domain state changes
model OutboxEvent {
  id          String    @id @default(cuid())
  eventName   String // e.g., 'payment.approved'
  payload     Json // Serialized event payload
  status      String    @default("PENDING") // PENDING, PROCESSED, FAILED
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  error       String? // Last error message if failed
  createdAt   DateTime  @default(now())
  processedAt DateTime? // When successfully processed

  @@index([status, createdAt], name: "idx_outbox_processing")
  @@map("outbox_events")
}

/// Idempotency table to prevent duplicate event processing
model ProcessedEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique // Reference to OutboxEvent.id
  eventName   String
  processedAt DateTime @default(now())
  processedBy String // Handler class name
  metadata    Json? // Additional processing info

  @@index([eventId], name: "idx_processed_event_lookup")
  @@map("processed_events")
}
